<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<GridPane xmlns="http://javafx.com/javafx"
          xmlns:fx="http://javafx.com/fxml"
          fx:controller="ru.mirea.railway.fx.controller.BookingFormController"
          stylesheets="@../css/app.css"
          hgap="10" vgap="10">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

    <Label text="Пассажир:"        GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <ComboBox fx:id="passengerBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="260"/>

    <Label text="Номер поезда:"    GridPane.rowIndex="1" GridPane.columnIndex="0"/>
    <TextField fx:id="trainField"  GridPane.rowIndex="1" GridPane.columnIndex="1" promptText="123А"/>

    <Label text="Откуда:"          GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <TextField fx:id="fromField"   GridPane.rowIndex="2" GridPane.columnIndex="1" promptText="Москва"/>

    <Label text="Куда:"            GridPane.rowIndex="3" GridPane.columnIndex="0"/>
    <TextField fx:id="toField"     GridPane.rowIndex="3" GridPane.columnIndex="1" promptText="Санкт-Петербург"/>

    <Label text="Дата отправления:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
    <DatePicker fx:id="dateField"   GridPane.rowIndex="4" GridPane.columnIndex="1" promptText="ДД.ММ.ГГГГ"/>

    <Label text="Время (HH:mm):"   GridPane.rowIndex="5" GridPane.columnIndex="0"/>
    <TextField fx:id="timeField"   GridPane.rowIndex="5" GridPane.columnIndex="1" promptText="08:30"/>

    <Label text="Вагон:"           GridPane.rowIndex="6" GridPane.columnIndex="0"/>
    <TextField fx:id="wagonField"  GridPane.rowIndex="6" GridPane.columnIndex="1" promptText="1–20"/>

    <Label text="Место:"           GridPane.rowIndex="7" GridPane.columnIndex="0"/>
    <TextField fx:id="seatField"   GridPane.rowIndex="7" GridPane.columnIndex="1" promptText="1–50"/>

    <Label text="Цена, ₽:"         GridPane.rowIndex="8" GridPane.columnIndex="0"/>
    <TextField fx:id="priceField"  GridPane.rowIndex="8" GridPane.columnIndex="1" promptText="1000–100000"/>

    <Label text="Статус:"          GridPane.rowIndex="9" GridPane.columnIndex="0"/>
    <ComboBox fx:id="statusBox"    GridPane.rowIndex="9" GridPane.columnIndex="1"/>

    <HBox spacing="10" GridPane.rowIndex="10" GridPane.columnIndex="0"
          GridPane.columnSpan="2">
        <Button text="Сохранить" minWidth="-Infinity" onAction="#onSave" defaultButton="true"/>
        <Button text="Отмена"    minWidth="-Infinity" onAction="#onCancel" cancelButton="true"/>
    </HBox>
</GridPane>